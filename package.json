{
  "name": "davinciui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "registry:blocks": "node scripts/build-blocks-registry.js",
    "validate:docs": "node scripts/validate-docs.mjs",
    "validate:registry": "node scripts/validate-registry.js",
    "generate:og": "node scripts/generate-og-image.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "screenshot": "node scripts/screenshot.js",
    "test:focus-carousel": "node scripts/test-focus-carousel.mjs",
    "test:cms-media-bento": "node scripts/test-cms-media-bento.mjs",
    "test:preloader-pro-v1": "node scripts/test-preloader-pro-v1.mjs",
    "test:preloader-pro-v4": "node scripts/test-preloader-pro-v4.mjs",
    "optimize:previews": "./scripts/optimize-preview-videos.sh",
    "recompress:previews": "scripts/venv/bin/python scripts/recompress-and-reupload-previews.py",
    "test:tilt-flip-polaroid": "node --test scripts/test-tilt-flip-polaroid.mjs",
