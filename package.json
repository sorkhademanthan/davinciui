{
  "name": "davinciui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "registry:blocks": "node scripts/build-blocks-registry.js",
    "validate:docs": "node scripts/validate-docs.mjs",
    "validate:registry": "node scripts/validate-registry.js",
    "verify:registry": "node scripts/verify-registry-urls.mjs",
    "generate:og": "node scripts/generate-og-image.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "screenshot": "node scripts/screenshot.js",
    "test:focus-carousel": "node scripts/test-focus-carousel.mjs",
    "test:cms-media-bento": "node scripts/test-cms-media-bento.mjs",
    "test:glitch-shred-preloader": "node scripts/test-glitch-shred-preloader.mjs",
    "test:editorial-card-arc-preloader": "node scripts/test-editorial-card-arc-preloader.mjs",
    "optimize:previews": "./scripts/optimize-preview-videos.sh",
    "recompress:previews": "scripts/venv/bin/python scripts/recompress-and-reupload-previews.py",
    "test:tilt-flip-polaroid": "node --test scripts/test-tilt-flip-polaroid.mjs",
    "test:editorial-curtain-preloader": "node --test scripts/test-premium-preloader-path.mjs",
    "check:basic-preview": "node scripts/check-basic-preview-runtime.mjs",
    "contentful:check": "node scripts/check-contentful.mjs",
    "contentful:migrate": "node scripts/migrate-to-contentful.cjs",
    "test:video-preview-grid": "node scripts/verify-video-preview-grid.mjs",
    "posters": "bash scripts/generate-posters.sh",
    "prebuild": "pnpm run posters -- --only-missing || true"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "turbo": "^2.6.3",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "contentful-management": "^12.21.0",
    "dialkit": "^2.2.1",
    "dotenv": "^18.0.10",
    "motion": "^14.14.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
