{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "framer": ["./demo/framer-shim.ts"]
    },
    "types": ["react", "react-dom"]
  },
  "include": ["StreamlineCarousel.tsx", "demo/main.tsx", "demo/framer-shim.ts"]
}
