# Base URL for the component registry
# Use http://localhost:3000 for local development
# Use your production URL (e.g., https://your-site.vercel.app) for production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Your registry namespace shown in install commands (defaults to "@davinciui")
NEXT_PUBLIC_REGISTRY_NAMESPACE=@davinciui

# Google Search Console verification code
# Get this from: https://search.google.com/search-console
# Format: just the code part, not the full meta tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# PostHog analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# GitHub stars (optional — raises the API quota for /api/github-stars).
# Create at: GitHub → Settings → Developer settings → Personal access tokens.
# No scopes needed for public repo star counts.
GITHUB_TOKEN=

# Cloudflare R2 – preview videos (used by scripts/recompress-and-reupload-previews.py and auto-upload-preview.py)
# Get from Cloudflare dashboard → R2 → Manage R2 API Tokens and account ID in URL
# The script reads these from REPO_ROOT/.env (project root) – copy this file to ../../.env if you run scripts from root
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=davinciui-previews
